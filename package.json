{
  "name": "vibescript",
  "private": true,
  "scripts": {
    "start": "bun ./demos/*/index.html",
    "start:lan": "bun ./demos/*/index.html --host=0.0.0.0 --port=3000",
    "start:templates": "bun ./drafts/demo_templates/*/index.html",
    "start:templates:lan": "bun ./drafts/demo_templates/*/index.html --host=0.0.0.0 --port=3000",
    "check": "tsgo && oxlint --type-aware demos --ignore-pattern '*.js'"
  },
  "devDependencies": {
    "@typescript/native-preview": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "latest",
    "playwright": "^1.59.1"
  }
}
