  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "oxlint": "latest",
    "oxlint-tsgolint": "latest",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.5"
  }
}
