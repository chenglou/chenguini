{
  "name": "vibescript",
  "private": true,
  "scripts": {
    "start": "bun ./demos/*/index.html",
    "start:lan": "bun ./demos/*/index.html --host=0.0.0.0 --port=3000",
    "start:specs": "bun ./demos_with_specs/*/round-*/index.html ./demos_with_specs/*/style-*/index.html ./demos_with_specs/*/overlay-*/index.html ./demos_with_specs/*/thin-level-*/index.html ./demos_with_specs/*/thin-repeat-*/index.html",
    "start:specs:lan": "bun ./demos_with_specs/*/round-*/index.html ./demos_with_specs/*/style-*/index.html ./demos_with_specs/*/overlay-*/index.html ./demos_with_specs/*/thin-level-*/index.html ./demos_with_specs/*/thin-repeat-*/index.html --host=0.0.0.0 --port=3000",
    "check": "tsgo && oxlint --type-aware demos --ignore-pattern '*.js'"
  },
  "devDependencies": {
    "@typescript/native-preview": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "latest",
    "playwright": "^1.59.1"
  }
}
