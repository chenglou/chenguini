{
  "name": "chenguini",
  "version": "0.0.1",
  "description": "Cheng's engineering & UI guidelines for avoiding spaghetti code",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenglou/chenguini.git"
  },
  "files": [
    "docs",
    "!docs/drafts",
    "demos"
  ],
  "scripts": {
    "start": "HOST=${HOST:-0.0.0.0}; PORT=3000; bun ./demos/*/index.html --host=$HOST:$PORT",
    "start:templates": "HOST=${HOST:-0.0.0.0}; PORT=3000; bun ./todos/demo_templates/*/index.html --host=$HOST:$PORT",
    "check": "tsc && oxlint --type-aware demos --ignore-pattern '*.js'"
  },
  "devDependencies": {
    "@chenglou/pretext": "^0.0.5",
    "oxlint": "latest",
    "oxlint-tsgolint": "latest",
    "typescript": "7.0.2"
  }
}
